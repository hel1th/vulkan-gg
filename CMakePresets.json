{
	"version": 3,
	"configurePresets": [
		{
			"name": "common",
			"hidden": true,
			"generator": "Ninja",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": true
			}
		},
		{
			"name": "debug",
			"inherits": "common",
			"binaryDir": "build-debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "release",
			"inherits": "common",
			"binaryDir": "build-release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "msvc-debug",
			"inherits": "debug",
			"binaryDir": "build-msvc-debug",
			"generator": "Visual Studio 18 2026"
		},
		{
			"name": "msvc-release",
			"inherits": "release",
			"binaryDir": "build-msvc-release",
			"generator": "Visual Studio 18 2026"
		},
		{
			"name": "mingw-debug",
			"inherits": "debug",
			"binaryDir": "build-mingw-debug",
			"generator": "MinGW Makefiles"
		},
		{
			"name": "mingw-release",
			"inherits": "release",
			"binaryDir": "build-mingw-release",
			"generator": "MinGW Makefiles"
		}
	]
}
